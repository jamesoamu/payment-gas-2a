# ==============================================================================
# EduPay Tracker - Environment Variables Configuration
# ==============================================================================
# Copy this file to '.env' or '.env.local' in your local development environment:
#   cp .env.example .env.local
#
# NOTE: In Vite, all client-side accessible variables MUST begin with 'VITE_'.
# Server-side variables without 'VITE_' are only accessible in Node.js / backend.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Platform / Server Environment Variables
# ------------------------------------------------------------------------------
# GEMINI_API_KEY: Required for Gemini AI API operations (e.g., smart reminders,
# analytics, AI-assisted bursar workflows).
# In Google AI Studio / Cloud Run, this is automatically injected at runtime.
GEMINI_API_KEY="your_gemini_api_key_here"

# APP_URL: The canonical URL where this application is hosted.
# Used for generating self-referential links, automated Paystack payment links,
# and receipts. In Cloud Run / AI Studio, this is injected automatically.
APP_URL="http://localhost:3000"


# ------------------------------------------------------------------------------
# 2. Client-Side Payment Gateway (Paystack)
# ------------------------------------------------------------------------------
# VITE_PAYSTACK_PUBLIC_KEY: Your Paystack Public API Key (starts with pk_test_ or pk_live_).
# Used to process student fee collections and academy subscription upgrades.
# If omitted, the app will run seamlessly in demo/simulation mode.
VITE_PAYSTACK_PUBLIC_KEY="pk_test_edupay_live_9281a0293f0b488"


# ------------------------------------------------------------------------------
# 3. Client-Side App Configuration (Optional)
# ------------------------------------------------------------------------------
# VITE_APP_URL: Client-exposed base URL for links generated within the frontend.
VITE_APP_URL="http://localhost:3000"

# VITE_APP_NAME: Display name of the application.
VITE_APP_NAME="EduPay Tracker"


# ------------------------------------------------------------------------------
# 4. Database / Backend (If connecting to Supabase - Optional)
# ------------------------------------------------------------------------------
# If you integrate Supabase for remote backend persistence, configure these:
# - Project URL: Found in Supabase Dashboard -> Project Settings -> API -> Project URL
# - Anon Key: Found in Supabase Dashboard -> Project Settings -> API -> anon public
# VITE_SUPABASE_URL="https://your-project-id.supabase.co"
# VITE_SUPABASE_ANON_KEY="your-anon-key-here"
